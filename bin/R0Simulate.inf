[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGUID={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
DriverVer=09/01/2024,1.0.0.0
CatalogFile=R0Simulate.cat

[DestinationDirs]
DefaultDestDir = 12

[DefaultInstall]
CopyFiles = R0Simulate.CopyFiles

[DefaultInstall.Services]
AddService = R0Simulate,0x00000002,R0Simulate.Service

[R0Simulate.CopyFiles]
R0Simulate.sys

[R0Simulate.Service]
DisplayName = %ServiceName%
ServiceType = 1
StartType = 1
ErrorControl = 1
ServiceBinary = %12%\R0Simulate.sys

[Strings]
ManufacturerName = "Your Company Name"
ServiceName = "R0Simulate Early Boot Driver"
DiskName = "R0Simulate Installation Disk"